NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — bot protection on the final registration step.
# Free at https://dash.cloudflare.com/?to=/:account/turnstile
# Both unset = no CAPTCHA enforced (fine for local dev, NOT for production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only used by `npm run seed:admin` (scripts/seed-admin.mjs) to create/update
# one staff account. Not read by the app itself — safe to fill in, run the
# script, then blank out or remove these two lines again.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
