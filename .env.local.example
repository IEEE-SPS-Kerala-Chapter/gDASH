NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — bot protection on the final registration step.
# Free at https://dash.cloudflare.com/?to=/:account/turnstile
# Both unset = no CAPTCHA enforced (fine for local dev, NOT for production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only used by `npm run seed:staff` (scripts/seed-staff.mjs) to create/update
# one staff account. Not read by the app itself — safe to fill in, run the
# script, then blank out or remove these lines again.
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
# Optional — admin | judge | volunteer, defaults to admin
SEED_STAFF_ROLE=
# Optional — defaults to the email
SEED_STAFF_NAME=

# Only used by `npm run seed:super-admin` (scripts/seed-super-admin.mjs,
# gitignored) to create/update the one super_admin account. Not read by the
# app itself — safe to fill in, run the script, then blank out or remove
# these lines again.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
# Optional — defaults to the email
SEED_SUPER_ADMIN_NAME=
